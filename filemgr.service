[Unit]
Description=Custom Files browser (port 8093, /var/downloads)
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian
EnvironmentFile=-/etc/nas-control-plane.conf
ExecStart=/usr/bin/python3 /home/debian/filemanager.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
