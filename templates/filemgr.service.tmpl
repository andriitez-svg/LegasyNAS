[Unit]
Description=Custom Files browser
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=-/etc/nas-control-plane.conf
ExecStart=/usr/bin/python3 @INSTALL_DIR@/filemanager.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
